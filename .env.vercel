tuuj# Vercel environment variables - import via Project > Settings > Environment Variables
# (paste or 'Import .env'). Gitignored: never commit this file.
# Empty or unset values (NEXT_PUBLIC_API_BASE_URL) are omitted on purpose; the app defaults them.

# Backend that /api/*, /docs/*, /files/* are proxied to (read at build time).
API_BASE_URL=https://www.pnc-spts-stg-api.me
# Real login against the backend. Never use "static" on a public URL.
NEXT_PUBLIC_AUTH_MODE=api
NEXT_PUBLIC_AUTH_API_URL=/api/v1/auth
NEXT_PUBLIC_API_TIMEOUT=15000
NEXT_PUBLIC_USER_MANAGEMENT_API=true
NEXT_PUBLIC_DEPOTS_API=true
# Ships to the browser; restrict it by HTTP referrer to your *.vercel.app domain.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyA5-HtP8s0Ab4QIHpHvVpt4jt2Cq5RpNxk
