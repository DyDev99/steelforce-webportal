# =============================================================================
# SteelForce Admin Web Portal - environment template.
#
# Copy to `.env.local` for local development (`npm run dev`). Never commit the
# copy: every `.env*` file except this one is gitignored and dockerignored.
#
# IMPORTANT: everything the app reads is BUILD-TIME configuration.
#   - NEXT_PUBLIC_* values are inlined into the browser bundle by `next build`.
#     They are visible to anyone who opens the site - never put a secret here.
#   - BACKEND_INTERNAL_URL / API_PROXY_URL are compiled into the rewrite table.
# Changing any of them for a deployed container means rebuilding the image.
# In CI they come from GitHub Actions Variables/Secrets (docs/deployment.md).
# =============================================================================

# Backend that /api/*, /docs/* and /files/* are proxied to (next.config.js).
# Precedence: BACKEND_INTERNAL_URL > API_BASE_URL > API_PROXY_URL.
# Unset -> the staging API (https://www.pnc-spts-stg-api.me).
API_BASE_URL=
API_PROXY_URL=
# BACKEND_INTERNAL_URL=

# Feature API base URL. Leave empty to call the same-origin proxy above, which
# avoids browser CORS preflight.
NEXT_PUBLIC_API_BASE_URL=

# Request timeout in milliseconds. Values below 1,000 ms are ignored.
NEXT_PUBLIC_API_TIMEOUT=15000

# Authentication is configured separately because the identity provider may live
# at a different host/path than the feature API. Empty -> /api/v1/auth.
NEXT_PUBLIC_AUTH_API_URL=
# `static` = offline demo accounts, `api` = the real identity endpoints.
# Empty -> `static` in development, `api` in a production `next build`.
NEXT_PUBLIC_AUTH_MODE=static

# Optional. Planning falls back to the built-in demo map when this is empty.
# Restrict the key by HTTP referrer in Google Cloud - it ships to the browser.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Set to true once the backend serves /api/v1/users and /api/v1/roles.
NEXT_PUBLIC_USER_MANAGEMENT_API=false

# Serve depots from /api/v1/customers instead of the demo master.
# Opt-in: the customer API is the authority on who a depot is, but carries none of the
# commercial analytics the CRM screens render (lifetime value, monthly revenue, open
# opportunities, visit counts). Turning this on trades plausible demo figures for
# honest blanks. See src/features/depots/repositories/mappers.ts.
NEXT_PUBLIC_DEPOTS_API=false
