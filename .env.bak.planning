# Target backend for Next.js proxy rewrites
API_PROXY_URL=https://www.pnc-spts-stg-api.me

# Leave empty for same-origin proxy through Next.js (bypasses browser CORS preflight)
NEXT_PUBLIC_API_BASE_URL=

# Live Authentication API
NEXT_PUBLIC_AUTH_API_URL=/api/v1/auth
NEXT_PUBLIC_AUTH_MODE=api

# User Management API Flag:
# Set to 'false' while backend server is preparing /api/v1/users and /api/v1/roles on staging.
# Set to 'true' once the endpoints are deployed to staging.
NEXT_PUBLIC_USER_MANAGEMENT_API=true

# Request timeout in milliseconds
NEXT_PUBLIC_API_TIMEOUT=15000
GOOQLE_MAPS_WEB_KEY=AIzaSyA5-HtP8s0Ab4QIHpHvVpt4jt2Cq5RpNxk

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyA5-HtP8s0Ab4QIHpHvVpt4jt2Cq5RpNxk

# Depots served by /api/v1/customers (the real master), not demo data.
NEXT_PUBLIC_DEPOTS_API=true
